generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String   @default("")
  passwordHash String
  role         String   @default("staff")
  createdAt    DateTime @default(now())

  salesReports SalesReport[]
}

model Product {
  id            Int      @id @default(autoincrement())
  brand         String
  category      String
  categoryLabel String
  model         String
  name          String
  priceMember   Int?
  // distributor this cost/price came from — "CMIT" (priceMember = raw cost)
  // or "SiS" (priceMember = SiS's own suggested resale price, not our cost).
  // Drives no pricing logic by itself; onlineMin/onlineMax always apply the
  // same multipliers to priceMember regardless of supplier.
  supplier      String   @default("CMIT")
  onlineMin     Int?
  onlineMax     Int?
  // staff-set exact storefront price. When non-null it overrides the auto price
  // computed within [onlineMin, onlineMax]. Never derived from products.json.
  publicPriceOverride Int?
  status        String   @default("in stock")
  // public storefront view counter. Bumped (atomic increment) by the public
  // POST /api/products/:id/view route when a detail page is opened. Never
  // touched by price edits / seeding.
  viewCount     Int      @default(0)
  sourceFile    String
  sheetDate     String
  note          String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])
}

// Customer order submitted from the public shop. Prices/total are recomputed
// server-side at creation (never trust the client cart snapshot). Admins move
// it through the status workflow in the staff catalog.
model Order {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  customerName  String   @default("")
  customerPhone String   @default("")
  address       String   @default("")
  items         Json // [{ id, brand, model, name, price, qty }]
  total         Int
  // PENDING -> APPROVED -> SHIPPED -> DONE, or CANCELLED at any point
  status        String   @default("PENDING")
  note          String   @default("")
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Staff-logged record of a completed installation/sale job, with photos.
// Standalone — not linked to the online Order table.
model SalesReport {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  staffId        String
  staff          User     @relation(fields: [staffId], references: [id])
  customerName   String   @default("")
  jobDescription String   @default("")
  amount         Int
  // string[] of relative paths under /uploads/sales/... — raw Json array,
  // same convention as Order.items (no separate photos table).
  photos         Json
  // { url: string; name: string }[] — quotation/bill/tax invoice attachments
  // (PDF or image). Kept separate from photos so the dashboard can list
  // them as named downloads instead of thumbnails.
  documents      Json     @default("[]")
  note           String   @default("")
  updatedAt      DateTime @updatedAt

  @@index([staffId])
  @@index([createdAt])
}

// Public storefront "technician member" account — entirely separate from
// staff User. Only reachable via a one-time MemberInvite signup link.
model Member {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  phone        String
  fullName     String
  shopName     String
  createdAt    DateTime @default(now())
}

// One-time signup invite generated by an admin (/catalog/users) and sent to
// the new person via LINE etc — same mechanism for every account type
// (intendedRole: "admin" | "staff" | "member"). The signup page branches its
// form/target table on intendedRole. Claimed atomically (updateMany
// used:false -> true) at signup time to close the race of double-submission.
model AccountInvite {
  id           String    @id @default(cuid())
  token        String    @unique
  intendedRole String
  used         Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?

  @@index([expiresAt])
}
