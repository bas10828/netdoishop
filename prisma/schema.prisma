generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  name         String   @default("")
  passwordHash String
  role         String   @default("staff")
  createdAt    DateTime @default(now())

  salesReports SalesReport[]
}

model Product {
  id            Int      @id @default(autoincrement())
  brand         String
  category      String
  categoryLabel String
  model         String
  name          String
  priceMember   Int?
  // distributor this cost/price came from — "CMIT" (priceMember = raw cost,
  // sold to ช่าง as-is) or "SiS" (priceMember = raw NDP * 1.10 markup, since
  // NDP is SiS's resale price not our cost — 2026-07-06 rule, applied in
  // build_catalog.py member_price()/SUPPLIER_MARKUP). onlineMin/onlineMax are
  // always based on raw cost, unaffected by this markup.
  supplier      String   @default("CMIT")
  // raw cost quotes we've received per distributor, e.g. {"CMIT":925,"SiS":845}
  // — kept even for the supplier we didn't pick as active, so switching back
  // (or adding a new one like "digitalcom") doesn't lose the old quote.
  supplierCosts Json?
  onlineMin     Int?
  onlineMax     Int?
  // staff-set exact storefront price. When non-null it overrides the auto price
  // computed within [onlineMin, onlineMax]. Never derived from products.json.
  publicPriceOverride Int?
  // for products with more than one entry in supplierCosts: which
  // distributor's cost basis the PUBLIC storefront price is computed from
  // (2026-07-06 rule). null = auto, default to CMIT (most of the catalog is
  // CMIT-sourced), falling back to whichever supplier has a quote if CMIT
  // doesn't. Only meaningful when supplierCosts has >1 key; ignored
  // otherwise. publicPriceOverride still wins over this when both are set.
  publicPriceSupplier String?
  status        String   @default("in stock")
  // public storefront view counter. Bumped (atomic increment) by the public
  // POST /api/products/:id/view route when a detail page is opened. Never
  // touched by price edits / seeding.
  viewCount     Int      @default(0)
  sourceFile    String
  sheetDate     String
  note          String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([brand, model])
  @@index([category])

  costHistory CostHistory[]
}

// Append-only log of raw supplier cost observations, one row per (product,
// supplier, pricelist) whenever the parsed cost differs from the last
// recorded value for that supplier — lets staff compare suppliers' cost
// trends over time before deciding who to order from, rather than only
// seeing the current supplierCosts snapshot on Product.
model CostHistory {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   String
  cost       Int
  sourceFile String
  recordedAt DateTime @default(now())

  @@index([productId, supplier])
}

// Customer order submitted from the public shop. Prices/total are recomputed
// server-side at creation (never trust the client cart snapshot). Admins move
// it through the status workflow in the staff catalog.
model Order {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  customerName  String   @default("")
  customerPhone String   @default("")
  address       String   @default("")
  items         Json // [{ id, brand, model, name, price, qty }]
  total         Int
  // PENDING -> APPROVED -> SHIPPED -> DONE, or CANCELLED at any point
  status        String   @default("PENDING")
  note          String   @default("")
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// Staff-logged record of a completed installation/sale job, with photos.
// Standalone — not linked to the online Order table.
model SalesReport {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  staffId        String
  staff          User     @relation(fields: [staffId], references: [id])
  customerName   String   @default("")
  jobDescription String   @default("")
  amount         Int
  // string[] of relative paths under /uploads/sales/... — raw Json array,
  // same convention as Order.items (no separate photos table).
  photos         Json
  // { url: string; name: string }[] — quotation/bill/tax invoice attachments
  // (PDF or image). Kept separate from photos so the dashboard can list
  // them as named downloads instead of thumbnails.
  documents      Json     @default("[]")
  note           String   @default("")
  updatedAt      DateTime @updatedAt
  devices        SalesReportDevice[]

  @@index([staffId])
  @@index([createdAt])
}

// One row per device found in a job's barcode/QR autoscan export
// (autoscan_results.xlsx: BarcodeText, Brand, Model, MAC, MAC_, FileName,
// Serial), attached to the specific SalesReport it belongs to — e.g.
// "installed cameras for customer X" -> which exact devices went in.
// BarcodeText is intentionally NOT stored — it's the raw scanned string,
// Serial already has the parsed value out of it. Most columns are
// nullable: real scans regularly have blank cells (a QR that didn't
// decode, a model the scanner couldn't read, etc).
model SalesReportDevice {
  id            Int         @id @default(autoincrement())
  salesReportId Int
  salesReport   SalesReport @relation(fields: [salesReportId], references: [id], onDelete: Cascade)
  brand         String?
  model         String?
  serialNumber  String?
  macAddress    String?
  deviceName    String? // e.g. "AP422" — the scan tool's FileName column
  sourceFile    String // original uploaded filename, for traceability
  createdAt     DateTime    @default(now())

  @@index([salesReportId])
  @@index([serialNumber])
}

// Public storefront "technician member" account — entirely separate from
// staff User. Only reachable via a one-time MemberInvite signup link.
model Member {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  phone        String
  fullName     String
  shopName     String
  createdAt    DateTime @default(now())
}

// One-time signup invite generated by an admin (/catalog/users) and sent to
// the new person via LINE etc — same mechanism for every account type
// (intendedRole: "admin" | "staff" | "member"). The signup page branches its
// form/target table on intendedRole. Claimed atomically (updateMany
// used:false -> true) at signup time to close the race of double-submission.
model AccountInvite {
  id           String    @id @default(cuid())
  token        String    @unique
  intendedRole String
  used         Boolean   @default(false)
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  usedAt       DateTime?

  @@index([expiresAt])
}
