# Copy to .env and fill in real values. .env is gitignored.

# Postgres connection string.
#   local dev:  postgresql://USER:PASSWORD@DB_HOST:5432/netdoi_money
#   in docker:  postgresql://USER:PASSWORD@<postgres-container>:5432/netdoi_money
DATABASE_URL="postgresql://USER:PASSWORD@DB_HOST:5432/netdoi_money"

# Public site URL (no trailing slash). Used for canonical, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3005"

# NextAuth
NEXTAUTH_URL="http://localhost:3005"
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Signs the public storefront's "สมาชิกช่าง" member session cookie — kept
# separate from NEXTAUTH_SECRET on purpose so the two auth systems (staff
# /catalog vs public member login) can never cross-contaminate.
# generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMBER_SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET"

# Seed admin account (prisma/seed.mjs creates the first login)
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# Chromium binary used by the /catalog price-proposal PDF/PNG export (puppeteer-core).
#   local dev (Windows):  C:\Program Files\Google\Chrome\Application\chrome.exe
#   docker (Alpine):      /usr/bin/chromium-browser  (installed via apk, see Dockerfile)
CHROMIUM_PATH="/usr/bin/chromium-browser"
